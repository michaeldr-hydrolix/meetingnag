<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>MeetingNag</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <options customize="always" require-scripts="false" hostArchitectures="arm64,x86_64"/>
  <domains enable_localSystem="true" enable_anywhere="false" enable_currentUserHome="false"/>
  <volume-check>
    <allowed-os-versions><os-version min="13.0"/></allowed-os-versions>
  </volume-check>

  <choices-outline>
    <line choice="app"/>
    <line choice="lidmode"/>
  </choices-outline>

  <choice id="app" title="MeetingNag"
          description="The menu-bar app and its login item. Replaces any previous version; your settings are kept."
          start_selected="true" start_enabled="false">
    <pkg-ref id="io.local.meetingnag.app"/>
  </choice>

  <choice id="lidmode" title="Lid-closed mode (optional)"
          description="Keeps the Mac awake with the lid closed from about 9 minutes before a meeting until you confirm the alert, and wakes it before meetings if it's asleep. Gives MeetingNag permission to run pmset sleep commands only. Normal sleep returns as soon as you click."
          start_selected="false">
    <pkg-ref id="io.local.meetingnag.lidmode"/>
  </choice>

  <pkg-ref id="io.local.meetingnag.app" version="__VERSION__" onConclusion="none">app.pkg</pkg-ref>
  <pkg-ref id="io.local.meetingnag.lidmode" version="__VERSION__" onConclusion="none">lidmode.pkg</pkg-ref>
</installer-gui-script>
